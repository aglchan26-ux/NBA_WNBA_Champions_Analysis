d=\"88ed19e8-35d2-4bf5-aecb-8de8b4691712\" class=\"plotly-graph-div\" style=\"height:400px; width:100%;\"></div>            <script type=\"text/javascript\">                                    window.PLOTLYENV=window.PLOTLYENV || {};                                    if (document.getElementById(\"88ed19e8-35d2-4bf5-aecb-8de8b4691712\")) {                    Plotly.newPlot(                        \"88ed19e8-35d2-4bf5-aecb-8de8b4691712\",                        [{\"hovertemplate\":\"Rim-running big league: %{y:.0%}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"line\":{\"color\":\"#2a78d6\",\"width\":2.5},\"mode\":\"lines\",\"name\":\"Rim-running big (league)\",\"x\":[2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026],\"y\":[0.13380503179828765,0.14177298464322877,0.13529734160872836,0.13522010133052156,0.12320955547315283,0.1270845942721415,0.13448548746350586,0.13627881636069175,0.12922058116725563,0.11731602933093271,0.11030781097923331,0.11254992570494254,0.11517222391151898,0.12408581802029113,0.12012407341361588,0.10920227571765921,0.08958276385952801,0.08339634716704417],\"type\":\"scatter\"},{\"hovertemplate\":\"Rim-running big champion: %{y:.0%}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"marker\":{\"color\":\"#2a78d6\",\"line\":{\"color\":\"#fcfcfb\",\"width\":2},\"size\":9},\"mode\":\"markers\",\"name\":\"Rim-running big (champion)\",\"showlegend\":false,\"x\":[2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026],\"y\":[0.2539175856065003,0.109967173977917,0.1851960640328977,0.1841709298826362,0.0,0.1521454545454545,0.0763705658164761,0.0142877970549642,0.1672791415551962,0.0676779463243874,0.0,0.1354237673256078,0.077822208551215,0.0,0.0,0.0428954423592493,0.0112270356089816,0.0],\"type\":\"scatter\"},{\"hovertemplate\":\"Spot-up 3-and-D wing league: %{y:.0%}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"line\":{\"color\":\"#eb6834\",\"width\":2.5},\"mode\":\"lines\",\
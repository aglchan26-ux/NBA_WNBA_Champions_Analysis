:400px; width:100%;\"></div>            <script type=\"text/javascript\">                                    window.PLOTLYENV=window.PLOTLYENV || {};                                    if (document.getElementById(\"caa825f9-d68b-4005-a5c1-bea6640b7e85\")) {                    Plotly.newPlot(                        \"caa825f9-d68b-4005-a5c1-bea6640b7e85\",                        [{\"customdata\":[[2004,\"DET\",18.0,2.0,29,\"defense-led\"],[2005,\"SA\",8.0,1.0,30,\"defense-led\"],[2006,\"MIA\",7.0,10.0,30,\"balanced\"],[2007,\"SA\",5.0,2.0,30,\"defense-led\"],[2008,\"BOS\",10.0,1.0,30,\"defense-led\"],[2009,\"LAL\",3.0,5.0,30,\"balanced\"],[2010,\"LAL\",11.0,4.0,30,\"balanced\"],[2011,\"DAL\",8.0,9.0,30,\"balanced\"],[2012,\"MIA\",7.0,4.0,30,\"balanced\"],[2013,\"MIA\",1.0,9.0,30,\"offense-led\"],[2014,\"SA\",6.0,4.0,30,\"balanced\"],[2015,\"GS\",2.0,1.0,30,\"balanced\"],[2016,\"CLE\",3.0,10.0,30,\"balanced\"],[2017,\"GS\",1.0,2.0,30,\"balanced\"],[2018,\"GS\",2.0,11.0,30,\"offense-led\"],[2019,\"TOR\",5.0,5.0,30,\"balanced\"],[2020,\"LAL\",11.0,3.0,30,\"balanced\"],[2021,\"MIL\",6.0,10.0,30,\"offense-led\"],[2022,\"GS\",15.0,2.0,30,\"defense-led\"],[2023,\"DEN\",4.0,17.0,30,\"balanced\"],[2024,\"BOS\",1.0,3.0,30,\"offense-led\"],[2025,\"OKC\",3.0,1.0,30,\"balanced\"],[2026,\"NY\",3.0,7.0,30,\"balanced\"]],\"hovertemplate\":\"%{customdata[0]} %{customdata[1]}\\u003cbr\\u003eoffense #%{customdata[2]:.0f}, defense #%{customdata[3]:.0f} of %{customdata[4]}\\u003cbr\\u003e%{customdata[5]}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"marker\":{\"color\":\"#2a78d6\",\"line\":{\"color\":\"#fcfcfb\",\"width\":2},\"size\":10},\"mode\":\"markers\",\"showlegend\":false,\"x\":[-1.000171075554519,1.5030544516738615,2.6825388697526336,2.8730491163764924,2.6315605446939543,4.293010123429838,1.0396220981451734,2.7229377048825114,2.0495532757386314,6.4513102745114566,4.099410771325381,5.9046254633828426,4.369427843639741,6.541172498437746,5.041445139809312,2.6382531565250678,1.503
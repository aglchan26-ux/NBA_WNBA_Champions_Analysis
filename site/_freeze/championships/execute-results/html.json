oses its shots in the regular season: share of field-goal attempts from three, and from the\nmid-range.\n\n::: {#0383e12e .cell execution_count=3}\n\n::: {.cell-output .cell-output-display execution_count=3}\n```{=html}\n<div>                            <div id=\"56a40fe2-a290-4a33-ba1b-4cd03cea3369\" class=\"plotly-graph-div\" style=\"height:380px; width:100%;\"></div>            <script type=\"text/javascript\">                                    window.PLOTLYENV=window.PLOTLYENV || {};                                    if (document.getElementById(\"56a40fe2-a290-4a33-ba1b-4cd03cea3369\")) {                    Plotly.newPlot(                        \"56a40fe2-a290-4a33-ba1b-4cd03cea3369\",                        [{\"hovertemplate\":\"NBA: %{y:.1%}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"legendgroup\":\"NBA\",\"line\":{\"color\":\"#2a78d6\",\"width\":2},\"marker\":{\"color\":\"#2a78d6\",\"size\":6},\"mode\":\"lines+markers\",\"name\":\"NBA\",\"showlegend\":true,\"x\":[2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026],\"y\":[0.1871879219081499,0.1959508240681532,0.2023395760705037,0.2123169346178388,0.222254156015066,0.2243062123925861,0.22215893477229,0.2218638857073964,0.2258647008451543,0.2434789578355199,0.2595125553914328,0.268202562538133,0.2899876669991499,0.3158883137434343,0.3369964412811388,0.3585190454692623,0.3837441741138239,0.3915158560596539,0.3988602542509748,0.3869975455772038,0.394412208160095,0.421340591914208,0.4156456686836956],\"type\":\"scatter\",\"xaxis\":\"x\",\"yaxis\":\"y\"},{\"hovertemplate\":\"WNBA: %{y:.1%}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"legendgroup\":\"WNBA\",\"line\":{\"color\":\"#eb6834\",\"width\":2},\"marker\":{\"color\":\"#eb6834\",\"size\":6},\"mode\":\"lines+markers\",\"name\":\"WNBA\",\"showlegend\":true,\"x\":[2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026],\"y\":[0.2453881563008341,0.2522164